FROM rayproject/ray:2.53.0-py311

USER root

# ----------------------------
# System dependencies and uv
# ----------------------------
# Install minimal tools required
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv (fast Python installer)
RUN pip install --no-cache-dir uv

# ----------------------------
# Install Python packages
# (torch via cu128 wheel — brings its own CUDA, no system CUDA needed)
# ----------------------------
COPY requirements_llm.txt /tmp/requirements.txt
RUN pip install --no-cache-dir torch==2.10.0 --index-url https://download.pytorch.org/whl/cu128 && uv pip install --system --no-cache \
    -r /tmp/requirements.txt \
 && rm -rf /tmp/*


USER ray
